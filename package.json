{
  "name": "slidev-vault",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.12.1",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "preview": "nuxt preview",
    "start": "node .output/server/index.mjs",
    "worker": "tsx worker/index.ts",
    "typecheck": "nuxt typecheck && tsc -p tsconfig.tools.json --noEmit",
    "test": "vitest run",
    "test:e2e": "node scripts/run-e2e.mjs",
    "test:watch": "vitest",
    "backup": "tsx scripts/backup.ts",
    "restore": "tsx scripts/restore.ts"
  },
  "dependencies": {
    "@noble/hashes": "2.3.0",
    "@slidev/cli": "52.19.0",
    "@slidev/theme-default": "0.25.0",
    "@slidev/theme-seriph": "0.25.0",
    "better-sqlite3": "13.0.3",
    "h3": "1.15.11",
    "mime-types": "3.0.2",
    "nuxt": "4.5.2",
    "vue": "3.5.41",
    "vue-router": "5.2.0",
    "yauzl": "3.4.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "@types/mime-types": "3.0.1",
    "@types/node": "26.2.0",
    "@types/yauzl": "3.4.0",
    "fflate": "0.8.3",
    "tsx": "4.23.12",
    "typescript": "7.0.2",
    "vitest": "4.1.10",
    "vue-tsc": "3.3.9"
  },
  "pnpm": {
    "overrides": {
      "@hono/node-server": "2.1.0",
      "dompurify": "3.4.13"
    },
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild"
    ]
  }
}
