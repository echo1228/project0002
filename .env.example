# Copy to .env before deploying. Use long, unique values.
ADMIN_DOMAIN=admin.example.com
SLIDES_DOMAIN=slides.example.com
INITIAL_ADMIN_PASSWORD=replace-with-at-least-14-characters
INITIAL_VIEWER_PASSWORD=replace-with-at-least-12-characters

# Runtime settings
NUXT_ADMIN_HOST=admin.example.com
NUXT_SLIDES_HOST=slides.example.com
NUXT_PUBLIC_ADMIN_ORIGIN=https://admin.example.com
NUXT_PUBLIC_SLIDES_ORIGIN=https://slides.example.com
NUXT_DATA_DIR=/data
NUXT_BUILD_EXCHANGE_DIR=/exchange
NUXT_COOKIE_SECURE=true
NUXT_INITIAL_ADMIN_PASSWORD=replace-with-at-least-14-characters
NUXT_INITIAL_VIEWER_PASSWORD=replace-with-at-least-12-characters
BUILD_TIMEOUT_MS=300000
MAX_UPLOAD_BYTES=26214400
MAX_EXTRACTED_BYTES=104857600
MAX_ARCHIVE_FILES=500
PNPM_STORE_DIR=/pnpm-store
